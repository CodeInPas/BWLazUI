      <Item>
        <Filename Value="src\controls\bsaccordion.pas"/>
        <UnitName Value="bsaccordion"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsbreadcrumb.pas"/>
        <UnitName Value="bsbreadcrumb"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bspagination.pas"/>
        <UnitName Value="bspagination"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsnavtabs.pas"/>
        <UnitName Value="bsnavtabs"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsnavbar.pas"/>
        <UnitName Value="bsnavbar"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsmodal.pas"/>
        <UnitName Value="bsmodal"/>
