      <Item>
        <Filename Value="src\controls\bsprogress.pas"/>
        <UnitName Value="bsprogress"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsspinner.pas"/>
        <UnitName Value="bsspinner"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bscheckbox.pas"/>
        <UnitName Value="bscheckbox"/>
      </Item>
      <Item>
        <Filename Value="src\controls\bsinput.pas"/>
